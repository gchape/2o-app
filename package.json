{
	"name": "2o-app",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"preview": "vite preview",
		"checkout:notifications": "node --env-file-if-exists=.env.${NODE_ENV:-development} --import tsx scripts/checkout-notifications.ts",
		"db:generate": "node --env-file-if-exists=.env.${NODE_ENV:-development} node_modules/drizzle-kit/bin.cjs generate",
		"db:migrate": "node --env-file-if-exists=.env.${NODE_ENV:-development} node_modules/drizzle-kit/bin.cjs migrate",
		"db:push": "node --env-file-if-exists=.env.${NODE_ENV:-development} node_modules/drizzle-kit/bin.cjs push",
		"db:studio": "node --env-file-if-exists=.env.${NODE_ENV:-development} node_modules/drizzle-kit/bin.cjs studio",
		"db:seed": "node --env-file-if-exists=.env.${NODE_ENV:-development} --import tsx scripts/seed.ts",
		"search:sync": "node --env-file-if-exists=.env.${NODE_ENV:-development} --import tsx scripts/search-sync.ts",
		"search:check": "node --env-file-if-exists=.env.${NODE_ENV:-development} --import tsx scripts/search-check.ts",
		"check": "biome check",
		"check:deprecations": "node --import tsx scripts/check-deprecations.ts",
		"fix": "biome check --write",
		"knip": "node --env-file-if-exists=.env.${NODE_ENV:-development} node_modules/knip/bin/knip.js",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"verify": "biome ci && tsc --noEmit && vitest run"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@better-auth-ui/core": "^1.7.30",
		"@better-auth-ui/react": "^1.7.30",
		"@better-auth/drizzle-adapter": "^1.7.12",
		"@hugeicons/core-free-icons": "^4.3.5",
		"@hugeicons/react": "^1.1.10",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "^5.104.5",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-router-ssr-query": "^1.167.3",
		"@tanstack/react-start": "1.169.4",
		"@tanstack/react-store": "^0.11.2",
		"better-auth": "^1.7.12",
		"bowser": "^2.14.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"decimal.js": "^10.6.0",
		"drizzle-orm": "1.0.0-rc.4",
		"es-toolkit": "^1.52.0",
		"nitro": "3.0.260903-beta",
		"pg": "^8.23.1",
		"react": "^19.3.1",
		"react-day-picker": "^10.0.2",
		"react-dom": "^19.3.1",
		"react-intersection-observer": "^11.0.1",
		"redis": "^6.3.0",
		"resend": "^6.34.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@fontsource-variable/archivo": "^5.3.0",
		"@fontsource-variable/figtree": "^5.3.0",
		"@fontsource-variable/noto-sans-georgian": "^5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/devtools-vite": "0.8.5",
		"@tanstack/react-devtools": "0.10.13",
		"@tanstack/react-router-devtools": "1.167.2",
		"@types/node": "^26.6.5",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"drizzle-kit": "1.0.0-rc.4",
		"knip": "^6.42.1",
		"shadcn": "^4.22.1",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"packageManager": "pnpm@12.14.0"
}

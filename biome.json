{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/routeTree.gen.ts",
			"!src/generated",
			"!src/components/ui",
			"!pnpm-lock.yaml",
			"!drizzle/**/snapshot.json"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": [
									"lucide*",
									"@lucide/**",
									"react-icons",
									"react-icons/**",
									"@heroicons/**",
									"@radix-ui/react-icons",
									"@phosphor-icons/**",
									"phosphor-react",
									"@tabler/icons*",
									"@fortawesome/**",
									"@ant-design/icons*",
									"@mui/icons-material",
									"@mui/icons-material/**"
								],
								"message": "Use @hugeicons/core-free-icons with @hugeicons/react; Hugeicons is the project icon library."
							}
						]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on",
				"recommended": true
			}
		}
	}
}

{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": ["src/routes/**/*.{ts,tsx}", "src/**/*.test.ts", "scripts/*.ts"],
	"project": ["src/**/*.{ts,tsx}"],
	"ignore": ["src/components/ui/**", "src/lib/auth/auth-plugin.ts"],
	"ignoreIssues": {
		"src/components/auth/auth-form.tsx": ["exports"],
		"src/components/auth/user/user-button.tsx": ["types"]
	},
	"ignoreDependencies": ["tw-animate-css", "shadcn", "@fontsource-variable/*"]
}
